<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="@dimen/banner_card_height"
    android:background="#FF181B22"
    android:clipChildren="true"
    android:clipToPadding="true">

    <ImageView
        android:id="@+id/banner_snapshot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/banner_fallback_icon"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:alpha="0.32"
        android:contentDescription="@null"
        android:visibility="gone" />

    <View
        android:id="@+id/banner_scrim"
        android:layout_width="match_parent"
        android:layout_height="84dp"
        android:layout_gravity="top"
        android:background="@drawable/banner_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="14dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/banner_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textDirection="locale"
            android:textSize="18sp"
            tools:text="@string/stub_application" />

        <TextView
            android:id="@+id/banner_app_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3"
            android:textColor="#E6FFFFFF"
            android:textDirection="locale"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="@string/keep_alive_label"
            tools:visibility="visible" />
    </LinearLayout>

    <View
        android:id="@+id/banner_outline"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false" />

</FrameLayout>
